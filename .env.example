# Production template: replace placeholders before use. No real credentials here.
DATABASE_URL=postgresql://rdbhs_backoffice:CHANGE_ME@127.0.0.1:5432/rdbhs_backoffice
# Generate a unique random key of at least 50 characters; do not use this placeholder.
SECRET_KEY=CHANGE_ME
DEBUG=False
ALLOWED_HOSTS=backoffice.elcone.dev
CSRF_TRUSTED_ORIGINS=https://backoffice.elcone.dev
STATIC_ROOT=/srv/rdbhs-backoffice/static
# Enable only after verifying HTTPS; use 300 for the initial rollout.
SECURE_HSTS_SECONDS=0

# Microsoft SSO: disabled by default. First-login email matching remains blocked.
# See docs/microsoft-sso.md before enabling. Never commit real credentials.
SSO_ENABLED=False
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Local HTTP development overrides:
# DATABASE_URL=sqlite:///db.sqlite3
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# STATIC_ROOT=./staticfiles
